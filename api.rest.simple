# REST API request template - Simple (fill blanks before use)

@baseUrl = http://localhost:9093

@adminFirstName =
@adminLastName =
@adminEmail =
@adminPassword =

@userUsername =
@userEmail =
@userPassword =

@adminResetToken =
@adminNewPassword =

@userResetCode =
@userNewPassword =

@studentId =
@studentFirstname =
@studentLastname =
@studentEmail =
@studentPhone =

@studentNewId =
@studentNewFirstname =
@studentNewLastname =
@studentNewEmail =
@studentNewPhone =

@subjectCode =
@subjectName =
@subjectCredits =

@subjectNewCode =
@subjectNewName =
@subjectNewCredits =

@teacherId =
@teacherFirstname =
@teacherLastname =
@teacherEmail =
@teacherPhone =

@teacherNewId =
@teacherNewFirstname =
@teacherNewLastname =
@teacherNewEmail =
@teacherNewPhone =

### 1. Admin Section
### 1.1 Register Admin
# @name adminRegister
POST {{baseUrl}}/admin/register-admin
Content-Type: application/json

{
  "firstname": "{{adminFirstName}}",
  "lastname": "{{adminLastName}}",
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}"
}

### 1.2 Admin Login
# @name adminLogin
POST {{baseUrl}}/admin/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{adminPassword}}",
  "rememberMe": true
}

### 1.3 Admin Forgot Password
# @name adminForgotPassword
POST {{baseUrl}}/admin/forgot-password
Content-Type: application/json

{
  "email": "{{adminEmail}}"
}

### 1.3.1 Admin Reset Password
# @name adminResetPassword
POST {{baseUrl}}/admin/reset-password
Content-Type: application/json

{
  "resetPasswordToken": "{{adminResetToken}}",
  "password": "{{adminNewPassword}}"
}

### 1.4 Admin Profile
# @name adminProfile
GET {{baseUrl}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

### 2. User Section
### 2.1 User Register
# @name userRegister
POST {{baseUrl}}/api/auth/local/register
Content-Type: application/json

{
  "username": "{{userUsername}}",
  "email": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.2 User Login
# @name userLogin
POST {{baseUrl}}/api/auth/local
Content-Type: application/json

{
  "identifier": "{{userEmail}}",
  "password": "{{userPassword}}"
}

### 2.3 User Forgot Password
# @name userForgotPassword
POST {{baseUrl}}/api/auth/forgot-password
Content-Type: application/json

{
  "email": "{{userEmail}}"
}

### 2.3.1 User Reset Password
# @name userResetPassword
POST {{baseUrl}}/api/auth/reset-password
Content-Type: application/json

{
  "code": "{{userResetCode}}",
  "password": "{{userNewPassword}}",
  "passwordConfirmation": "{{userNewPassword}}"
}

### 2.4 User Profile
# @name userProfile
GET {{baseUrl}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3. Content Section
### 3.1 Student
### 3.1.1 Student Create
# @name studentCreate
POST {{baseUrl}}/api/students
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
  "studentId": "{{studentId}}",
  "firstname": "{{studentFirstname}}",
  "lastname": "{{studentLastname}}",
  "email": "{{studentEmail}}",
  "phone": "{{studentPhone}}"
}

### 3.1.2 Student List All
# @name studentListAll
GET {{baseUrl}}/api/students
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.1.3 Student List with ID
# @name studentListById
GET {{baseUrl}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.1.4 Student Update
# @name studentUpdate
PUT {{baseUrl}}/api/students/{{studentCreate.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
  "studentId": "{{studentNewId}}",
  "firstname": "{{studentNewFirstname}}",
  "lastname": "{{studentNewLastname}}",
  "email": "{{studentNewEmail}}",
  "phone": "{{studentNewPhone}}"
}

### 3.2 Subject
### 3.2.1 Subject Create
# @name subjectCreate
POST {{baseUrl}}/api/subjects
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
  "code": "{{subjectCode}}",
  "name": "{{subjectName}}",
  "credits": {{subjectCredits}}
}

### 3.2.2 Subject List All
# @name subjectListAll
GET {{baseUrl}}/api/subjects
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.2.3 Subject List with ID
# @name subjectListById
GET {{baseUrl}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.2.4 Subject Update
# @name subjectUpdate
PUT {{baseUrl}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
  "code": "{{subjectNewCode}}",
  "name": "{{subjectNewName}}",
  "credits": {{subjectNewCredits}}
}

### 3.3 Teacher
### 3.3.1 Teacher Create
# @name teacherCreate
POST {{baseUrl}}/api/teachers
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
  "teacherId": "{{teacherId}}",
  "firstname": "{{teacherFirstname}}",
  "lastname": "{{teacherLastname}}",
  "email": "{{teacherEmail}}",
  "phone": "{{teacherPhone}}"
}

### 3.3.2 Teacher List All
# @name teacherListAll
GET {{baseUrl}}/api/teachers
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.3.3 Teacher List with ID
# @name teacherListById
GET {{baseUrl}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{userLogin.response.body.$.jwt}}

### 3.3.4 Teacher Update
# @name teacherUpdate
PUT {{baseUrl}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer {{userLogin.response.body.$.jwt}}

{
  "teacherId": "{{teacherNewId}}",
  "firstname": "{{teacherNewFirstname}}",
  "lastname": "{{teacherNewLastname}}",
  "email": "{{teacherNewEmail}}",
  "phone": "{{teacherNewPhone}}"
}

# .env template - fill blanks before use (see .env)
# Database - required by docker-compose.yml:6-9,92-98
DATABASE_CLIENT=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=

# pgAdmin - required by docker-compose.yml:51-52
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# Strapi - required by docker-compose.yml:99-103
STRAPI_JWT_SECRET=

# API - Base (api.rest.simple:3 @baseUrl)
BASE_URL=http://localhost:9093

# API - Admin (api.rest.simple:5-8 @adminFirstName,@adminLastName,@adminEmail,@adminPassword)
ADMIN_FIRSTNAME=
ADMIN_LASTNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# API - User (api.rest.simple:10-12 @userUsername,@userEmail,@userPassword)
USER_USERNAME=
USER_EMAIL=
USER_PASSWORD=

# API - Admin Reset (api.rest.simple:14-15 @adminResetToken,@adminNewPassword)
ADMIN_RESET_TOKEN=
ADMIN_NEW_PASSWORD=

# API - User Reset (api.rest.simple:17-18 @userResetCode,@userNewPassword)
USER_RESET_CODE=
USER_NEW_PASSWORD=

# API - Content 3.1 Student (api.rest.simple:20-24 @studentId,@studentFirstname,@studentLastname,@studentEmail,@studentPhone)
STUDENT_ID=
STUDENT_FIRSTNAME=
STUDENT_LASTNAME=
STUDENT_EMAIL=
STUDENT_PHONE=

# API - Content 3.1.4 Student Update (api.rest.simple:26-30 @studentNewId,@studentNewFirstname,@studentNewLastname,@studentNewEmail,@studentNewPhone)
STUDENT_NEW_ID=
STUDENT_NEW_FIRSTNAME=
STUDENT_NEW_LASTNAME=
STUDENT_NEW_EMAIL=
STUDENT_NEW_PHONE=

# API - Content 3.2 Subject (api.rest.simple:32-34 @subjectCode,@subjectName,@subjectCredits)
SUBJECT_CODE=
SUBJECT_NAME=
SUBJECT_CREDITS=

# API - Content 3.2.4 Subject Update (api.rest.simple:36-38 @subjectNewCode,@subjectNewName,@subjectNewCredits)
SUBJECT_NEW_CODE=
SUBJECT_NEW_NAME=
SUBJECT_NEW_CREDITS=

# API - Content 3.3 Teacher (api.rest.simple:40-44 @teacherId,@teacherFirstname,@teacherLastname,@teacherEmail,@teacherPhone)
TEACHER_ID=
TEACHER_FIRSTNAME=
TEACHER_LASTNAME=
TEACHER_EMAIL=
TEACHER_PHONE=

# API - Content 3.3.4 Teacher Update (api.rest.simple:46-50 @teacherNewId,@teacherNewFirstname,@teacherNewLastname,@teacherNewEmail,@teacherNewPhone)
TEACHER_NEW_ID=
TEACHER_NEW_FIRSTNAME=
TEACHER_NEW_LASTNAME=
TEACHER_NEW_EMAIL=
TEACHER_NEW_PHONE=
